# Portfolio LANKAMAR — hosting estático (Apache)
#
# Objetivo: las rutas válidas de React responden 200 y las direcciones
# inexistentes responden 404 real. Antes, todo se reescribía a index.html,
# así que una URL inventada devolvía 200.
#
# Vite (dev y preview) no lee este archivo: sólo aplica en el servidor.

<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # CV-001: private PDFs are absent from this tree; no access-control reliance here.

  # 1. Rutas válidas del SPA, con o sin barra final -> su propio shell con
  #    metadatos (HTTP 200). Cada ruta tiene dist/<ruta>/index.html, generado
  #    en el build desde seo.js.
  #    Esta lista está sincronizada con App.tsx y seo.js. Si se agrega o quita
  #    una ruta, hay que actualizarla acá. No agregar rutas inexistentes.
  RewriteRule ^(trayectoria|proyectos|publicaciones|docencia|repositorios|cv|contacto|simulador-ecg)/?$ $1/index.html [L]

  # 2. Archivos y directorios que existen: se sirven tal cual.
  #    Cubre assets, robots.txt, sitemap.xml, favicon, og-image.png,
  #    /credenciales/, /capturas/ y /v1/.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Cualquier otra dirección NO se reescribe: Apache responde 404 y
  #    muestra /404.html con ese mismo estado (ver ErrorDocument).
</IfModule>

# Página de error. Apache la sirve conservando el código 404,
# salvo que se pida /404.html directamente (en ese caso, 200).
ErrorDocument 404 /404.html

# Cabeceras de seguridad (mod_headers). Se aplican a todas las respuestas.
# No se agrega CSP propia para no romper Font Awesome ni Google Fonts:
# Hostinger ya envía Content-Security-Policy: upgrade-insecure-requests.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
